APP_NAME="Andronaco TV"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tv.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_tv
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="tv@andronaco.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# OTIF backlog slide — sample until the Epicor connection is wired up.
OTIF_SOURCE=sample
OTIF_REFRESH_MINUTES=10
OTIF_MAX_AGE_MINUTES=60
# EPICOR_DSN=EpicorMSSQL
# EPICOR_HOST=
# EPICOR_PORT=1433
# EPICOR_DATABASE=
# EPICOR_USERNAME=
# EPICOR_PASSWORD=
